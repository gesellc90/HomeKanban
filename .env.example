# HomeKanban — Beispielkonfiguration. Kopieren nach `.env` und anpassen.
# `.env` wird nicht eingecheckt (siehe .gitignore) — hier stehen keine echten Geheimnisse.

# Basis-URL, die ab M5 in jedem gedruckten QR-Code steckt. Hostname statt IP verwenden, damit
# Etiketten einen Adresswechsel des Pi überleben (docs/PLAN.md §8, §10 R6). Vor dem ersten
# Etikettendruck endgültig festlegen — eine spätere Änderung macht bereits geklebte Etiketten
# ungültig.
HOMEKANBAN_BASE_URL=http://raspberrypi.local:8181

HOMEKANBAN_PORT=8181
HOMEKANBAN_DB_PATH=/data/homekanban.db

# Pflicht seit M4: Ohne Wert verweigern `/api/shopping-list` und `/api/shopping-list/export` den
# Dienst mit 503 (docs/PLAN.md §8, L12). Der restliche Teil der App bleibt ohne Authentifizierung.
# Einen Wert erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Hier steht bewusst kein Beispielwert — siehe docs/KURZBEFEHL.md.
HOMEKANBAN_API_KEY=

HOMEKANBAN_UNDO_WINDOW_MINUTES=10
HOMEKANBAN_LEAD_DAYS=7
HOMEKANBAN_BACKUP_DIR=/data/backups
HOMEKANBAN_BACKUP_KEEP=7d,4w

TZ=Europe/Berlin
LOG_LEVEL=info
