# HomeKanban — Beispielkonfiguration. Kopieren nach `.env` und anpassen.
# `.env` wird nicht eingecheckt (siehe .gitignore) — hier stehen keine echten Geheimnisse.

# Basis-URL, die in jedem gedruckten QR-Code steckt. In M5 endgültig festgelegt (docs/PLAN.md §8,
# §10 R6): eigener mDNS-Name statt IP und statt `raspberrypi.local`, damit die Etiketten auch eine
# Umbenennung oder einen Hardwaretausch des Pi überleben.
#
# ACHTUNG: Nach dem ersten Etikettendruck nicht mehr ändern — sämtliche geklebten Codes zeigen
# sonst ins Nichts, und es gibt keine Migration dafür, nur Neudruck. Der Name braucht auf dem Pi
# einen mDNS-Alias (Avahi), siehe ops/ETIKETTEN.md.
HOMEKANBAN_BASE_URL=http://homekanban.local:8181

# Steckt über die BASE_URL ebenfalls in jedem QR-Code. Vor dem ersten Etikettendruck mit
# `ss -ltnp` auf dem Pi bestätigen, dass „Hängt!“ den Port nicht belegt (Annahme A1, offen bis M6).
HOMEKANBAN_PORT=8181
HOMEKANBAN_DB_PATH=/data/homekanban.db

# Pflicht seit M4: Ohne Wert verweigern `/api/shopping-list` und `/api/shopping-list/export` den
# Dienst mit 503 (docs/PLAN.md §8, L12). Der restliche Teil der App bleibt ohne Authentifizierung.
# Einen Wert erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Hier steht bewusst kein Beispielwert — siehe docs/KURZBEFEHL.md.
HOMEKANBAN_API_KEY=

HOMEKANBAN_UNDO_WINDOW_MINUTES=10
HOMEKANBAN_LEAD_DAYS=7
HOMEKANBAN_BACKUP_DIR=/data/backups
HOMEKANBAN_BACKUP_KEEP=7d,4w

TZ=Europe/Berlin
LOG_LEVEL=info
